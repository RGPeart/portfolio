---
import Base from '../layouts/Base.astro';
import { person, intro, highlights, projects } from '../data/site';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base>
  <section class="hero">
    <div class="hero-text">
      <p class="eyebrow">{person.title} · {person.location}</p>
      <h1>{intro.greeting}</h1>
      <p class="name"><span class="grad">{person.name}</span></p>
      {intro.paragraphs.map((t) => <p class="summary">{t}</p>)}
      <div class="actions">
        <a class="btn primary" href={`${base}/projects/`}>See my projects</a>
        {person.resume && <a class="btn" href={`${base}/${person.resume}`}>Resume (PDF)</a>}
        <a class="btn" href={person.github}>GitHub</a>
        <a class="btn" href={person.linkedin}>LinkedIn</a>
      </div>
    </div>
    <div class="avatar">
      {person.photo ? (
        <img src={`${base}/${person.photo}`} alt={person.photoAlt} width="320" height="320" fetchpriority="high" />
      ) : (
        <span class="initials" aria-hidden="true">{person.initials}</span>
      )}
    </div>
  </section>

  <ul class="stats" aria-label="Highlights">
    {highlights.map((h) => (
      <li><strong>{h.value}</strong><span>{h.label}</span></li>
    ))}
  </ul>

  <section class="section" aria-labelledby="featured">
    <h2 id="featured">Featured projects</h2>
    <div class="cards">
      {projects.map((p) => (
        <article class="card">
          <h3>{p.name}</h3>
          <p class="blurb">{p.blurb}</p>
          <ul class="stack" aria-label="Technologies">
            {p.stack.slice(0, 5).map((s) => <li>{s}</li>)}
          </ul>
        </article>
      ))}
    </div>
    <p class="more"><a href={`${base}/projects/`}>All project details →</a></p>
  </section>
</Base>
